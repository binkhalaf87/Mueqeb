# انسخ هذا الملف إلى .env.local واملأ القيم.
# للتطوير المحلي: npm run db:start (Postgres في Docker) ثم npm run db:reset && npm run seed

# قاعدة البيانات (على Railway: DATABASE_URL من خدمة Postgres، عبر ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/mueqeb

# مفتاح توقيع الجلسات وروابط الملفات (32 حرفاً عشوائياً على الأقل): openssl rand -hex 32
AUTH_SECRET=

# مجلد المستندات الخاصة (على Railway: مجلد داخل Volume، مثل /data/storage)
STORAGE_DIR=.data/storage

# ===== الدفع (وضع الاختبار فقط) =====
# mock = بوابة اختبار محلية (بطاقة ناجحة 4111 1111 1111 1111، مرفوضة 4000 0000 0000 0002)
# moyasar = Moyasar بمفاتيح test فقط (sk_test_…)
PAYMENT_PROVIDER=mock
# سر توقيع webhook بوابة الاختبار المحلية (16 حرفاً على الأقل)
MOCK_PAYMENT_WEBHOOK_SECRET=local-dev-mock-webhook-secret
# بوابة الاختبار مرفوضة في بيئة production على Railway (RAILWAY_ENVIRONMENT_NAME)؛
# اضبطها على 1 فقط لنسخة عرض تجريبية بلا دفع حقيقي
# ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=1
# Moyasar (عند PAYMENT_PROVIDER=moyasar):
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# مُجدول المهام داخل الخادم (انتهاء مهل العروض، الإكمال التلقائي، التأخر): off لتعطيله
# SCHEDULER=off
