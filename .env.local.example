# انسخ هذا الملف إلى .env.local واملأ القيم.
# للتطوير المحلي: شغّل `npm run db:start` ثم `npx supabase status` لعرض القيم.

# عنوان Supabase (API_URL)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# المفتاح العام (PUBLISHABLE_KEY أو ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# المفتاح السري (SECRET_KEY أو SERVICE_ROLE_KEY) — للسكربتات على الخادم فقط (seed)
# لا تضعه أبداً في متغير يبدأ بـ NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# ===== الدفع (وضع الاختبار فقط) =====
# mock = بوابة اختبار محلية (بطاقة ناجحة 4111 1111 1111 1111، مرفوضة 4000 0000 0000 0002)
# moyasar = Moyasar بمفاتيح test فقط (sk_test_…)
PAYMENT_PROVIDER=mock
# سر توقيع webhook بوابة الاختبار المحلية (16 حرفاً على الأقل)
MOCK_PAYMENT_WEBHOOK_SECRET=local-dev-mock-webhook-secret
# Moyasar (عند PAYMENT_PROVIDER=moyasar):
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
